# ── Cloud fallback (optional) ────────────────────────────────────────────────
# Free keys: https://console.groq.com  |  https://aistudio.google.com
GROQ_API_KEY=
GOOGLE_API_KEY=

# ── Gradio UI auth (optional, recommended for LAN/shared networks) ───────────
# Secure default: with no auth set the UI binds 127.0.0.1 (localhost only). Set
# BOTH username + password to enable a login prompt AND auto-expose on the LAN
# (0.0.0.0). To expose without auth (not recommended), set GRADIO_SERVER_NAME
# explicitly — a warning prints in that case.
# GRADIO_USERNAME=
# GRADIO_PASSWORD=
# GRADIO_SERVER_NAME=0.0.0.0   # override the bind host (default 127.0.0.1, or 0.0.0.0 when auth is set)

# ── Chat UI  (Gradio / LangGraph agent) ──────────────────────────────────────
# The "Inference Engine" dropdown is auto-discovered at startup from the local
# Ollama daemon (_LLM_OPTIONS in app.py; label → (provider, model)). Current entries:
#   qwen3.8:latest              → Ollama local  (default)
#   gemma4:31b-mlx              → Ollama local
#   deepseek-v4-pro:cloud       → Ollama local  (RAG Q&A)
#   gemini-2.5-flash / -pro     → Gemini cloud  (needs GOOGLE_API_KEY)
#   Groq                        → Groq cloud    (needs GROQ_API_KEY; model = GROQ_MODEL in src/llm.py)
# To change the default/pinned engine, edit _PINNED_MODEL in app.py — not this file.
#
# OLLAMA_CHAT_MODEL is only a fallback default (used when a code path omits the
# model); the dropdown entries above each carry their own explicit model.
OLLAMA_CHAT_MODEL=qwen3.8:latest
OLLAMA_NUM_CTX=32768                          # Ollama context window (default 2048 is too small for ReAct + history)
# Ollama sampling overrides (src/llm.py:get_llm). Set explicitly so per-model
# Modelfile defaults (some ship temperature=1 / presence_penalty=1.5) don't
# silently control generation. Malformed values warn + fall back to the default.
# OLLAMA_SEED=0                               # deterministic sampling (int)
# OLLAMA_TOP_K=40                             # top-k sampling (int)
# OLLAMA_TOP_P=0.9                            # nucleus sampling (float)
# OLLAMA_REPEAT_PENALTY=1.1                   # repetition penalty (float)
# PORT=7860                                   # override the Gradio server port (unset → Gradio default 7860)

# MLX chat model — for the latent mlx_lm.server chat backend. NOT listed in the
# current Inference Engine dropdown (chat runs on Ollama/cloud). Kept for the
# code path in src/llm.py; the MLX_SERVER_* vars below only apply if it's used.
#   ~128 GB RAM  →  mlx-community/Qwen3-Next-80B-A3B-Instruct-8bit  (~85 GB, MoE 3B-active; highest quality, needs mlx-lm >= 0.27)
#   ~32 GB+ RAM  →  mlx-community/Qwen3-30B-A3B-Instruct-2507-4bit  (~17 GB, MoE 3B-active; default)
#   ~8 GB RAM    →  mlx-community/Qwen3-4B-4bit                     (~2.5 GB)
MLX_CHAT_MODEL=mlx-community/Qwen3-30B-A3B-Instruct-2507-4bit
MLX_MAX_TOKENS=4096                           # max tokens per MLX generation (ingest + latent mlx chat)
MLX_SERVER_HOST=127.0.0.1
MLX_SERVER_PORT=8081
MLX_PROMPT_CACHE_SLOTS=4                      # KV-cache slots → reuse system prompt + tool schemas across calls
MLX_PROMPT_CACHE_BYTES=8000000000             # 8 GB KV cache budget
MLX_SERVER_STARTUP_TIMEOUT=1200               # seconds to wait for mlx_lm.server to load a model (raise for large/first-time weights, e.g. 80B ~85 GB)

# ── Ingest LLM  (summarisation + verse extraction) ───────────────────────────
# ollama_local → uses OLLAMA_INGEST_MODEL (default); stable, no MLX dependency
# mlx          → Apple Silicon Neural Engine; faster but less stable
# groq/gemini  → cloud fallback; set the matching API key above
INGEST_PROVIDER=ollama_local
MLX_INGEST_MODEL=mlx-community/Qwen3-4B-4bit   # auto-downloaded on first run
# qwen3:4b — small + fast for summarisation (quality rivals much larger models);
# the chat engine stays on qwen3.8:latest (OLLAMA_CHAT_MODEL) — ingest no longer
# shares the chat model, so there IS a model-swap on ingest now.
OLLAMA_INGEST_MODEL=qwen3:4b                     # only used when INGEST_PROVIDER=ollama_local
# Multimodal model that reads image-based (textless) sermon PDFs during ingest.
# ~50% of PS (slides) PDFs are image-only with no extractable text, and some
# groups have no NG (notes) file at all — the vision model renders the pages and
# recovers topic/speaker/theme/key-verse/summary that text extraction can't.
# gemma4:e4b is small + fast + multimodal (runs via Ollama, no MLX runtime).
# Set empty to disable the vision fallback.
OLLAMA_VISION_MODEL=gemma4:e4b

# ── Embeddings  (ChromaDB) ───────────────────────────────────────────────────
# Ollama is NOT needed for embeddings — only for the chat UI and ingest LLM (OLLAMA_CHAT_MODEL / OLLAMA_INGEST_MODEL above).
# EMBED_BACKEND selects the embedder. Switching backends requires a wipe + re-ingest
# (python ingest.py --wipe  &&  python -m src.ingestion.bible.bible_ingest --wipe) so
# stored and query vectors come from the same model.
#   st        → BAAI/bge-m3 via sentence-transformers (PyTorch MPS, fp32) — 1024-dim (default)
#   mlx_bge   → mlx-community/bge-m3-mlx-fp16 (Apple Silicon) — 1024-dim, ~2x faster, ~3 GB RAM
#   mlx_qwen  → mlx-community/Qwen3-Embedding-8B-4bit-DWQ — 4096-dim, higher MTEB, ~6 GB RAM, slower
EMBED_BACKEND=st
# MLX_EMBED_MODEL=mlx-community/bge-m3-mlx-fp16   # override the HF repo for mlx_* backends
# MLX_EMBED_MAX_LEN=1024                          # token cap per chunk for mlx_* backends
